# vm_up.sh 가 <SITE_HOST> 를 공인 IP(또는 도메인)로 치환한다. IP 접속은 SNI 가 없어 default_sni 가 필수.
{
	default_sni <SITE_HOST>
}
https://<SITE_HOST> {
	tls internal
	basicauth {
		# caddy hash-password --plaintext '비밀번호' 결과로 교체 (vm_up.sh 가 자동 치환)
		demo $2a$14$REPLACE_WITH_BCRYPT_HASH
	}
	reverse_proxy web:8080
}
:80 {
	redir https://{host}{uri} permanent
}
